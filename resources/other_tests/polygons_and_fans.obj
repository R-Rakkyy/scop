# exercises fan-triangulation of "f" lines with more than 3 corners
# (for_each_triangle_in_face: v0,v1,v2 / v0,v2,v3 / v0,v3,v4 / ...)

# a quad (2 triangles)
v -3.0 0.0 0.0
v -2.0 0.0 0.0
v -2.0 1.0 0.0
v -3.0 1.0 0.0
f 1 2 3 4

# a pentagon (3 triangles)
v 0.0  0.0  0.0
v 1.0  0.0  0.0
v 1.3  0.8  0.0
v 0.5  1.3  0.0
v -0.3 0.8  0.0
f 5 6 7 8 9

# a hexagon (4 triangles)
v  2.0  0.0  0.0
v  2.87 0.5  0.0
v  2.87 1.5  0.0
v  2.0  2.0  0.0
v  1.13 1.5  0.0
v  1.13 0.5  0.0
f 10 11 12 13 14 15

# a triangle for comparison (1 triangle, the base case: refs.size()-2 == 1)
v 5.0 0.0 0.0
v 6.0 0.0 0.0
v 5.5 1.0 0.0
f 16 17 18
