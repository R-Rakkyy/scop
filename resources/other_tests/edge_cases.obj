# case 1: valid baseline triangle
v 0.0 0.0 0.0
v 1.0 0.0 0.0
v 0.0 1.0 0.0
f 1 2 3

# case 2: malformed 'v' line (non-numeric y)
v 1.0 notanumber 0.0

# case 3: valid must keep going
v 1.0 1.0 0.0
f 2 3 4

# case 4: malformed 'vt' line (non-numeric u)
vt notanumber 0.5

# case 5: malformed 'vn' line (non-numeric z)
vn 0.0 1.0 notanumber

# case 6: explicit, deliberately non-unit normal
vn 2.0 0.0 0.0
f 1//1 2//1 3//1

# case 7: face with an out-of-range vertex index
f 1 2 999

# case 8: face with a non-numeric vertex token
f 1 2 abc

# case 9: valid 
v 2.0 0.0 0.0
f 2 4 5
