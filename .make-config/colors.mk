COLOR_RESET 		:= $(shell printf '\033[0m')
COLOR_BOLD 			:= $(shell printf '\033[1m')
COLOR_SUCCESS 		:= $(shell printf '\033[1;32m')
COLOR_INFO 			:= $(shell printf '\033[0;33m')
COLOR_WARN 			:= $(shell printf '\033[1;33m')
COLOR_ERROR 		:= $(shell printf '\033[1;31m')
COLOR_CYAN 			:= $(shell printf '\033[0;36m')
COLOR_MAG 			:= $(shell printf '\033[0;35m')
COLOR_BLUE 			:= $(shell printf '\033[0;34m')
BG_YELLOW 			:= $(shell printf '\033[43m')

SEP 				:= $(COLOR_BLUE)=========================================$(COLOR_RESET)
ARROW 				:= $(COLOR_MAG)-->$(COLOR_RESET)
OK_MARK 			:= $(COLOR_SUCCESS)[OK]$(COLOR_RESET)
WARN_MARK 			:= $(COLOR_WARN)[WARN]$(COLOR_RESET)
ERR_MARK 			:= $(COLOR_ERROR)[ERR]$(COLOR_RESET)
